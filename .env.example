# CCTV Live Analytics & Dashboard Environment Configuration
# Real values go in .env, which docker-compose reads for interpolation.
#
# Camera display names (optional - defaults to Camera A, Camera B, etc.)
# Customize these to your local names to match your physical cameras and existing data:
CAM_A_NAME=
CAM_B_NAME=
CAM_C_NAME=
CAM_D_NAME=

# MAIN stream = what gets recorded (keep it 1080p for clip quality).
#   e.g. rtsp://user:pass@192.0.2.20:554/h264Preview_01_main
CAM_A_URL=
CAM_B_URL=
CAM_C_URL=
# A camera may be analysis-only (no recording) — see config/live.yaml
CAM_D_URL=

# SUB stream = the realtime ANALYSIS path (lower res, same 15 fps) — optional but
# strongly recommended: less CPU, less pipe bandwidth, same detection quality.
# Leave blank to analyze the main stream instead.
#   e.g. rtsp://user:pass@192.0.2.20:554/h264Preview_01_sub
CAM_A_SUB_URL=
CAM_B_SUB_URL=
CAM_C_SUB_URL=
CAM_D_SUB_URL=

# Notifications
DASHBOARD_URL=http://localhost:8080
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
WEBHOOK_URL=

# Web Dashboard Basic Auth (optional - leave blank to disable)
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# Inference Offload / Quiet Server Mode (optional)
# Offload GPU forward passes to a remote worker node (e.g. desktop PC with a GPU)
# so the camera server stays quiet with minimal fan noise and power draw:
# REALTIME_DEVICE=remote
# DETAILED_DEVICE=remote
# REMOTE_INFER_URL=http://<worker-ip>:8099
