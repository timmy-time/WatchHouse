# CCTV Live Analytics & Dashboard Environment Configuration
# Real values should be placed in .env, which docker-compose reads for interpolation.
#
# Camera URLs should be the DVR main-stream RTSP URLs,
# e.g. rtsp://user:pass@192.0.2.20:554/h264Preview_01_main
CAM_CAMA_URL=
CAM_CAMB_URL=
CAM_CAMC_URL=

# Notifications
DASHBOARD_URL=http://localhost:8080
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
WEBHOOK_URL=

# Web Dashboard Basic Auth (optional - leave blank to disable)
DASHBOARD_USER=
DASHBOARD_PASSWORD=
